{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "ambev-developer-evaluation",
    "Audience": "ambev-developer-evaluation-api",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": "5672",
    "VirtualHost": "/",
    "Username": "guest"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=ambev_developer_evaluation;Username=developer;Password=${DB_PASSWORD}",
    "Redis": "redis:6379"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "OpenTelemetry": {
    "ServiceName": "ambev-developer-evaluation",
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  }
}
